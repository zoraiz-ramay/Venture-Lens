# Copy to .env and fill in. Never commit .env.
GLASSDOLLAR_API_KEY=
# LLM provider — set ONE of these. GEMINI_API_KEY takes priority when both are set.
# Gemini (Google AI Studio key, https://aistudio.google.com/apikey). Default model: gemini-2.5-flash
GEMINI_API_KEY=
# OpenAI / Siemens gateway
OPENAI_API_KEY=
# Optional overrides
# LLM_BASE_URL=https://llm.sdc.siemens.cloud/v1     (openai provider only)
# LLM_MODEL=gemini-2.5-flash                        (or gpt-5.4 etc.)
LLM_TIMEOUT=25

# Local data mode (recommended): point at your applications Excel; pitch PDFs go in
# the pdfs/ folder next to it. In Docker these live under ./data (mounted at /data):
#   ./data/glassdollar_applications.xlsx   ./data/pdfs/*.pdf
# GLASSDOLLAR_XLSX=/data/glassdollar_applications.xlsx
# PDF_DIR=/data/pdfs
